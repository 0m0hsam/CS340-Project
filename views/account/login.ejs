<% if(title){ %>
    <h1><%= title %></h1>
<% } %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<% if(messages) { %>
<h4 class="messages"><%- messages() %></h4>
<% } %>

<form action="/account/login" method="POST">
    <div class="form-group">
        <label for="email">Email:</label>
        <input type="email" id="email" name="account_email" required value="<%= locals.account_email %>">
    </div>
    <div class="form-group">
        <label for="password">Password:</label>
        <input type="password" id="password" name="account_password" minlength="12" 
        pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$" required>

        <div id="show-password-container"><input type="checkbox" id="show-password" onclick="togglePasswordVisibility()">
            <P>Show password</P></div>
    </div>

    <button type="submit">Login</button>
    <p>Don't have an account? <a href="/account/registration">Sign up here</a>.</p>
    <p><a href="/account/forgot-password">Forgot your password?</a></p>
</form>

<script>
function togglePasswordVisibility() {
    const passwordField = document.getElementById('password');
    const showPasswordCheckbox = document.getElementById('show-password');
    passwordField.type = showPasswordCheckbox.checked ? 'text' : 'password';
}
</script>
