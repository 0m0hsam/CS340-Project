<h1>Update Inventory Item</h1>
<%- errors %>
<%= messages() %>


<form action="/inv/update_inventory" method="POST">
 <div id="add_inventory">
    <div class="form-group">
        <label for="classificationList">Classification:</label>
        <%- dropdown %>
        </div>
    <div class="form-group">
        <label for="make">Make:</label>
        <input type="text" id="make" name="inv_make" required value="<%= locals.inv_make %>">
    </div>
    <div class="form-group">
        <label for="model">Model:</label>
        <input type="text" id="model" name="inv_model" required value="<%= locals.inv_model %>">
    </div>
    <div class="form-group">
        <label for="description">Description:</label>
        <textarea id="description" name="inv_description" rows="4" cols="40" required><%= locals.inv_description %></textarea>
    </div>
    <div class="form-group">
        <label for="imagepath1">Image Path 1:</label>
        <input type="text" id="imagepath1" name="inv_image" required value="<%= locals.inv_image %>">
    </div>
    <div class="form-group">
        <label for="imagepath2">Image Path 2:</label>
        <input type="text" id="imagepath2" name="inv_thumbnail" required value="<%= locals.inv_thumbnail %>">
    </div>
    <div class="form-group">
        <label for="price">Price:</label>
        <input type="number" id="price" name="inv_price" step="0.01" min="0" required value="<%= locals.inv_price %>">
    </div>
    <div class="form-group">
        <label for="year">Year:</label>
        <input type="number" id="year" name="inv_year" min="1886" max="2100" required value="<%= locals.inv_year %>">
    </div>
    <div class="form-group">
        <label for="miles">Miles:</label>
        <input type="number" id="miles" name="inv_miles" min="0" required value="<%= locals.inv_miles %>">
    </div>
    <div class="form-group">
        <label for="colour">Colour:</label>
        <input type="text" id="colour" name="inv_color" required value="<%= locals.inv_color %>">
    </div>
    <div class="form-group">
        <button type="submit">Update Vehicle</button>
    </div>
    <div class="form-group">
     <input type="hidden" name="inv_id"
    <% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
    <% } %>>
    </div>
</form>


