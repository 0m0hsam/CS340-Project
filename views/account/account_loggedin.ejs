<% if(title){ %>
    <h1><%= title %></h1>
<% } %>

<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<h1>Welcome <%= locals.accountData.account_firstname %>, you're logged in</h1> 

<% if(messages) { %>
<h4 class="messages"><%- messages() %></h4>
<% } %>

<a href="/account/edit"><p>Edit Account information</p></a>


<% if(locals.accountData.account_type == "Admin" || locals.accountData.account_type == "Employee") { %>
    <h2>Admin Options</h2>
    <a href="/inv/"><p>Manage Inventory</p></a>
<% } %>